# chanmeng-slack-waterline triage in CI.
#
# Copy to .github/workflows/slack-triage.yml in your WORKSPACE DATA REPO
# (the private one), and set SLACK_USER_TOKEN as a repository secret.
#
# TWO RULES, BOTH LOAD-BEARING:
#
#   1. --no-record, always. A machine must never advance a read position:
#      nobody read anything, and the next human run would find a clean board
#      over a real backlog.
#
#   2. A backlog is not a build failure. The gates exit with a finding count so
#      a script can branch, but a workflow that goes red because somebody posted
#      in Slack trains everyone to ignore red — which costs more than the
#      backlog it was meant to surface.
#
# Consider whether you want a token that can read your DMs living in a CI
# provider. Running the triage locally and only the reporting here is a
# reasonable split.

name: slack-triage

on:
  schedule:
    # 07:00 NZST on weekday mornings. Adjust to your timezone.
    - cron: '0 19 * * 0-4'
  workflow_dispatch:

permissions:
  contents: read
  issues: write

concurrency: slack-triage

jobs:
  triage:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@v4

      - uses: actions/checkout@v4
        with:
          repository: ChanMeng666/chanmeng-slack-waterline
          path: .waterline

      - uses: actions/setup-node@v4
        with:
          node-version: '22'

      - name: Triage (report only, records nothing)
        env:
          SLACK_USER_TOKEN: ${{ secrets.SLACK_USER_TOKEN }}
          SLACK_WATERLINE_DIR: ${{ github.workspace }}
        run: |
          node .waterline/skills/chanmeng-slack-waterline/scripts/discover.mjs --all --no-record

      - name: Enumerate Slack itself
        env:
          SLACK_USER_TOKEN: ${{ secrets.SLACK_USER_TOKEN }}
          SLACK_WATERLINE_DIR: ${{ github.workspace }}
        # Exits with the finding count. That is information, not a failure.
        continue-on-error: true
        run: |
          node .waterline/skills/chanmeng-slack-waterline/scripts/coverage.mjs --enumerate-only

      - name: Open or update the backlog issue
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          BODY=$(mktemp)
          {
            echo "Automated triage — nothing here has been read."
            echo
            echo '```'
            node .waterline/skills/chanmeng-slack-waterline/scripts/discover.mjs --all --no-record 2>/dev/null || true
            echo '```'
          } > "$BODY"

          EXISTING=$(gh issue list --label slack-triage --state open --json number --jq '.[0].number')
          if [ -n "$EXISTING" ]; then
            # Edited in place. A comment notifies everyone watching, so only
            # comment when the actionable set actually changes.
            gh issue edit "$EXISTING" --body-file "$BODY"
          else
            gh issue create --title "Slack backlog" --label slack-triage --body-file "$BODY"
          fi
